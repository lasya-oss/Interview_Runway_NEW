{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interview-runway-staging",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "interview-runway-staging",
      "database_id": "d495f238-e28e-47d2-8e6b-b59cf24717de",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "AUTH_ALLOWED_DOMAIN": "vividlabsai.com",
    "AI_EVALUATION_DEBUG_SHAPE": "1",
    "CEREBRAS_MODEL": "__staging-force-groq-fallback__",
    "GOOGLE_CLIENT_ID": "773066800394-e7t7o8l73nbja6srkrqil4ktj449dc7o.apps.googleusercontent.com",
    "GROQ_BRAIN_MODEL": "openai/gpt-oss-120b",
    "INTERNAL_FULL_ACCESS_DOMAIN": "vividlabsai.com",
    "PADDLE_ENV": "sandbox"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
