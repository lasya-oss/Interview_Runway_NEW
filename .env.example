GOOGLE_CLIENT_ID=773066800394-e7t7o8l73nbja6srkrqil4ktj449dc7o.apps.googleusercontent.com
AUTH_ALLOWED_DOMAIN=vividlabsai.com
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma- or space-separated exact Vivid Labs addresses for temporary Foundation QA access.
TEST_FOUNDATION_EMAILS=
# Comma- or space-separated exact Vivid Labs addresses for temporary full Second Seat QA access.
TEST_SECOND_SEAT_EMAILS=
# Comma- or space-separated exact addresses (any domain) for temporary
# pre-launch QA with full user-level access to Vault, Second Seat, and Human
# Calibration. Grants no admin or internal-only functionality.
TEST_FULL_ACCESS_EMAILS=

# Server-only assessment reasoning. These reuse Meeting Copilot's provider roles.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_BRAIN_MODEL=openai/gpt-oss-120b

# Server-only, short-lived bridge from an authenticated Second Seat account to
# the local Meeting Copilot. Use at least 32 random characters.
MEETING_COPILOT_BRIDGE_SECRET=

# Server-only Google Workspace Gmail sender credentials. GOOGLE_CLIENT_ID above
# is shared with sign-in; keep the remaining values in the Sites environment and
# never expose them through NEXT_PUBLIC_* variables.
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_SENDER_EMAIL=
# Comma- or space-separated exact Vivid Labs recipient addresses.
MEETING_COPILOT_PROFILE_RECIPIENTS=
